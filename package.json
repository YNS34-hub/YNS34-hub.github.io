{
  "name": "the-memory-palace",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/register-personal-media.mjs",
    "prebuild": "node scripts/register-personal-media.mjs",
    "media:register": "node scripts/register-personal-media.mjs",
    "import:steam": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/import-steam.ps1",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "build:public": "node scripts/register-personal-media.mjs --public && tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:browser": "node scripts/check-palace.mjs",
    "test:audio-travel": "node scripts/check-audio-travel.mjs",
    "qa:visual": "node scripts/capture-art-direction.mjs",
    "sync:github": "node scripts/audit-public-projects.mjs",
    "sync:vendor": "node scripts/sync-three.mjs",
    "test:hero": "node scripts/check-hero.mjs",
    "qa:quality": "node scripts/capture-quality-leap.mjs",
    "test:quality": "node scripts/check-quality-leap.mjs",
    "test:listening": "node scripts/check-listening-identity.mjs",
    "qa:performance": "node scripts/measure-quality-leap.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "globals": "^16.3.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.3.0",
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.10.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.180.0",
    "zustand": "^5.0.8"
  }
}
